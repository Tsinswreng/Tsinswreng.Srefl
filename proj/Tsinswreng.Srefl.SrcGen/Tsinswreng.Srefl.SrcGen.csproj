<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<!-- <TargetFramework>net10.0</TargetFramework> -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<!-- <ImplicitUsings>enable</ImplicitUsings> -->
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<!-- <PublishAot>true</PublishAot> -->
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<LangVersion>latest</LangVersion>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<PackageId>Tsinswreng.Srefl.SrcGen</PackageId>
		<Version>1.0.5-alpha</Version>
		<Authors>Tsinswreng</Authors>
		<Description>Source generator package for Tsinswreng.Srefl.</Description>
		<PackageTags>SourceGenerator;Analyzer;Reflection;Serialization</PackageTags>
		<!-- <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath> -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Tsinswreng.Srefl" Version="1.0.2-alpha" />
		<PackageReference Update="Tsinswreng.CsCore" GeneratePathProperty="true" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- <ProjectReference Include="../../../Tsinswreng.CsCore/proj/Tsinswreng.CsCore/Tsinswreng.CsCore.csproj" /> -->
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\Tsinswreng.Srefl.SrcGen.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="$(OutputPath)\Tsinswreng.Srefl.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="$(PkgTsinswreng_CsCore)\lib\netstandard2.0\Tsinswreng.CsCore.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<!-- <ItemGroup>
	<Compile Remove="Generated\**\*.cs" />
	<EmbeddedResource Remove="Generated\**\*.resx" />
	<None Remove="Generated\**\*.cs" />
</ItemGroup> -->


	<!-- <ItemGroup>
	<None Update="tools\install.ps1" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools\install.ps1" />
	<None Update="tools\uninstall.ps1" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools\uninstall.ps1" />
</ItemGroup> -->

</Project>
